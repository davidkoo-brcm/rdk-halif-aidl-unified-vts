{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": [
            "--config", "${workspaceFolder}/host/tests/configs/vts_rack_config.yml",
            "--deviceConfig", "${workspaceFolder}/host/tests/configs/vts_deviceConfig.yml"
            ],
            "console": "integratedTerminal"
        }
    ]
}